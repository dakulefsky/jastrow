{
  "schemaVersion": 1,
  "id": "com.kulefsky.jastrow",
  "name": "Aramaic → Eng.",
  "version": "1.11.14",
  "description": "Offline Aramaic and rabbinic Hebrew to English translation, with concise meanings and optional examples.",
  "author": "DanTheMan",
  "stability": "beta",
  "entrypoint": "index.html",
  "minAppVersion": "0.9.97",
  "sdkVersion": "1.x",
  "permissions": [
    "app.startup_contributions",
    "reader.context_menu",
    "reader.open",
    "app.run_on_startup",
    "app.background_keep_alive",
    "events.subscribe:reader.selection_changed",
    "network.access",
    "events.subscribe:plugin.permissions_changed",
    "library.links.read",
    "library.content.read"
  ],
  "network": {
    "enabled": true,
    "allowlist": [
      "https://otzaria-dictionary-community.dakulefsky.workers.dev",
      "https://www.sefaria.org"
    ]
  },
  "contributes": {
    "toolTab": {
      "title": "Aramaic → Eng.",
      "order": 900,
      "defaultPinned": true,
      "iconName": "book_24_regular"
    },
    "startup": {
      "activationEvents": [
        "app.startup",
        "reader.selection_changed"
      ],
      "keepAlive": true
    },
    "background": {
      "entrypoint": "background.html"
    }
  }
}
