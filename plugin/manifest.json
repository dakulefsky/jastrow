{
  "schemaVersion": 1,
  "id": "com.kulefsky.jastrow",
  "name": "Aramaic → Eng.",
  "version": "1.11.25",
  "description": "Offline Aramaic and rabbinic Hebrew dictionary with evidence-based contextual recommendations.",
  "author": "DanTheMan",
  "stability": "beta",
  "entrypoint": "index.html",
  "minAppVersion": "0.9.97",
  "sdkVersion": "1.x",
  "permissions": [
    "app.startup_contributions",
    "reader.context_menu",
    "reader.open",
    "app.run_on_startup",
    "app.background_keep_alive",
    "events.subscribe:reader.selection_changed",
    "events.subscribe:reader.current_ref_changed",
    "events.subscribe:navigation.changed",
    "library.links.read",
    "library.content.read"
  ],
  "contributes": {
    "toolTab": {
      "title": "Aramaic → Eng.",
      "order": 900,
      "defaultPinned": true,
      "iconName": "book_24_regular"
    },
    "startup": {
      "activationEvents": [
        "app.startup",
        "reader.selection_changed"
      ],
      "keepAlive": true,
      "contextMenuItems": [
        {
          "id": "jastrow-lookup",
          "type": "submenu",
          "title": "Aramaic → Eng.",
          "icon": "alef_with_score_24_regular",
          "children": [
            {
              "id": "jastrow-meaning-fallback",
              "title": "Open full dictionary",
              "openPlugin": true
            }
          ]
        }
      ]
    },
    "background": {
      "entrypoint": "background.html"
    }
  }
}