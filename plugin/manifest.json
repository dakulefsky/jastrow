{
  "schemaVersion": 1,
  "id": "com.kulefsky.jastrow",
  "name": "Jastrow",
  "version": "1.3.4",
  "description": "Offline Aramaic and rabbinic Hebrew to English dictionary, with Jastrow entries and word-form lookup.",
  "author": "DanTheMan",
  "stability": "beta",
  "entrypoint": "index.html",
  "minAppVersion": "0.9.97",
  "sdkVersion": "1.x",
  "permissions": [
    "app.startup_contributions",
    "reader.context_menu",
    "reader.open"
  ],
  "network": {
    "enabled": false,
    "allowlist": []
  },
  "contributes": {
    "toolTab": {
      "title": "Jastrow",
      "order": 900,
      "defaultPinned": true,
      "iconName": "book_24_regular"
    },
    "startup": {
      "contextMenuItems": [
        {
          "id": "jastrow-lookup",
          "title": "Jastrow — English",
          "icon": "book_24_regular",
          "contexts": [
            "reader-selection",
            "reader-page-shape-selection"
          ],
          "openPlugin": true
        }
      ]
    }
  }
}
