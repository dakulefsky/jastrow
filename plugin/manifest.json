{
  "schemaVersion": 1,
  "id": "com.kulefsky.jastrow",
  "name": "Jastrow",
  "version": "1.5.0",
  "description": "Offline Aramaic and rabbinic Hebrew to English lookup, with concise Krupnik & Silbermann definitions and detailed Jastrow entries.",
  "author": "DanTheMan",
  "stability": "beta",
  "entrypoint": "index.html",
  "minAppVersion": "0.9.97",
  "sdkVersion": "1.x",
  "permissions": [
    "app.startup_contributions",
    "reader.context_menu",
    "reader.open",
    "app.run_on_startup",
    "app.background_keep_alive",
    "events.subscribe:reader.selection_changed"
  ],
  "network": {
    "enabled": false,
    "allowlist": []
  },
  "contributes": {
    "toolTab": {
      "title": "Jastrow",
      "order": 900,
      "defaultPinned": true,
      "iconName": "book_24_regular"
    },
    "startup": {
      "activationEvents": [
        "app.startup",
        "reader.selection_changed"
      ],
      "keepAlive": true
    },
    "background": {
      "entrypoint": "background.html"
    }
  }
}
