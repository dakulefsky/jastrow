{
  "schemaVersion": 1,
  "id": "com.kulefsky.aramaic-hebrew",
  "name": "ארמית לעברית",
  "version": "1.3.8",
  "description": "מילון ארמי־עברי על פי הנוסח העברי המקורי של קרופניק וזילברמן, עם איתור משמעות המילון בתרגום העברי של שטיינזלץ, לשימוש ללא חיבור לרשת.",
  "author": "DanTheMan",
  "stability": "beta",
  "entrypoint": "index.html",
  "minAppVersion": "0.9.97",
  "sdkVersion": "1.x",
  "permissions": [
    "app.startup_contributions",
    "reader.context_menu",
    "app.run_on_startup",
    "app.background_keep_alive",
    "events.subscribe:reader.selection_changed",
    "events.subscribe:reader.current_ref_changed",
    "events.subscribe:navigation.changed",
    "reader.open",
    "library.links.read",
    "library.content.read"
  ],
  "contributes": {
    "toolTab": {
      "title": "ארמית לעברית",
      "order": 900,
      "defaultPinned": true,
      "iconName": "book_24_regular"
    },
    "startup": {
      "activationEvents": [
        "app.startup",
        "reader.selection_changed"
      ],
      "keepAlive": true
    },
    "background": {
      "entrypoint": "background.html"
    }
  }
}
